.venv/
data/
gallery/
__pycache__/
*.pyc
.DS_Store
.env
.env~
_site/
/index.html
runs/*/train_*/
# Per-area relight realization cache (prepare_realizations) — deterministic
# renders, rebuilt on demand, never committed.
render_cache/
# Oversized files pulled out of a commit by loop.sh's quarantine_oversized
# live here and must NEVER be committed — they are deliberately excluded
# scratch (100-144 MB training renders once slipped in via `git add -A
# state/` and broke every push for ~10 h, 2026-07-23). Keep them untracked.
state/quarantine/
# Full per-flight Monte-Carlo records (0.5 s tracks) — reproducible exactly
# via `python -m sim.flightsim --flights 100 --seed 1 --flight-dir ...`;
# the committed, slimmed copies the site fetches live in assets/sim/flights/.
sim/out/mc_flights/
# same for the mission flights (sim/missions.py --flight-dir); slimmed copies in assets/sim/missions/.
sim/out/mission_flights/
# the Spree showcase flight's camera frames (sim/missions.py --save-crops-for); slimmed copies in assets/sim/missions/spree/crops_f2/.
sim/out/mission_crops/
